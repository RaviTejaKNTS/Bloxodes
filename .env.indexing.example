# Google Indexing API job settings.
# Keep this disabled by default. The script also requires --apply before it can call Google.
GOOGLE_INDEXING_API_ENABLED=false

# Production should prefer GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_BASE64 as a secret.
# Local runs can point at an ignored key file instead.
GOOGLE_INDEXING_SERVICE_ACCOUNT_EMAIL=indexing@bloxodes.iam.gserviceaccount.com
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_INDEXING_SERVICE_ACCOUNT_FILE=.env.secrets/google-indexing-service-account.json
GOOGLE_INDEXING_SCOPE=https://www.googleapis.com/auth/indexing

# Submission controls.
GOOGLE_INDEXING_SITE_URL=https://bloxodes.com
GOOGLE_INDEXING_SITEMAP_URL=https://bloxodes.com/sitemap.xml
GOOGLE_INDEXING_DAILY_LIMIT=50
GOOGLE_INDEXING_BATCH_LIMIT=10
GOOGLE_INDEXING_REQUEST_DELAY_MS=1000
GOOGLE_INDEXING_RESUBMIT_AFTER_HOURS=168
GOOGLE_INDEXING_MAX_SITEMAPS=200

# Use Supabase for recurring production/GitHub jobs so the daily cap and URL rotation persist.
GOOGLE_INDEXING_STATE_BACKEND=supabase
