# ==== Required ====
# For local-first development, copy `.env.local.example` to `.env.local`
# and fill local Supabase values from `npm run supabase:status:env`.
NEXT_PUBLIC_SITE_URL=https://bloxodes.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
AUTH_SESSION_SECRET=
# Set to 0 for effectively permanent login (until logout/revocation).
AUTH_SESSION_TTL_SECONDS=604800

# Puzzle sync
PUZZLES_TIMEZONE=America/New_York
LINKEDIN_LI_AT=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
# Set to true to re-enable the app's built-in consent banner and script gating.
NEXT_PUBLIC_ENABLE_LOCAL_CONSENT=false

# ==== Security (optional) ====
# Defaults to `enforce` in production and `off` in development.
# Valid values: off, report-only, enforce
CSP_MODE=enforce

# Roblox OAuth (login)
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Optional: force exact callback used by Roblox-only login flow.
# Example: https://bloxodes.com/auth/roblox/callback/login
# Legacy-compatible: https://bloxodes.com/auth/roblox/callback
# This must exactly match one of the redirect URIs registered in your Roblox OAuth app.
# For local development, register your localhost callback too if Roblox allows it.
ROBLOX_OAUTH_LOGIN_REDIRECT_URI=

# ==== Revalidation (optional but required for on-demand refresh) ====
REVALIDATE_ENDPOINT=
REVALIDATE_SECRET=
# Optional: if set on the deployed app, `/api/revalidate` will also purge
# the matching Cloudflare edge cache entries after successful origin revalidation.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional targeted warmup after purge. Keep enabled in production so Cloudflare
# refills changed URLs before the next visitor arrives.
CLOUDFLARE_WARM_AFTER_PURGE=true
CLOUDFLARE_WARM_MAX_PATHS=80
CLOUDFLARE_WARM_CONCURRENCY=4

# Optional local/operator Cloudflare token for managing Cache Rules through
# scripts/automation/cloudflare-emergency-cache.mjs. Do not deploy this token to
# the app runtime unless that runtime also needs to manage Cloudflare rules.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BLOXODES_API=

# ==== IndexNow (disabled for the website runtime) ====
# Optional server-side origin override for scripts and webhooks.
SITE_URL=
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
# Example: https://bloxodes.com/<INDEXNOW_KEY>.txt
INDEXNOW_KEY_LOCATION=
# Optional override; defaults to https://api.indexnow.org/indexnow
INDEXNOW_ENDPOINT=

# ==== IndexNow bootstrap script (one-time bulk submission) ====
# Optional override; defaults to <SITE_URL>/sitemap.xml
INDEXNOW_BOOTSTRAP_SITEMAP_URL=
# Optional controls
INDEXNOW_BATCH_SIZE=1000
INDEXNOW_MAX_SITEMAPS=200
INDEXNOW_REQUEST_DELAY_MS=0
INDEXNOW_DRY_RUN=false
