# Managed development Supabase. Never put production service-role credentials here.
ARTICLE_DEV_SUPABASE_URL=https://PROJECT_REF.supabase.co
ARTICLE_DEV_SUPABASE_SERVICE_ROLE=replace-me
SUPABASE_MEDIA_BUCKET=article-media
SUPABASE_MEDIA_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/article-media

# Public, GET-only Bloxodes production inventory endpoint.
ARTICLE_PRODUCTION_INVENTORY_URL=https://bloxodes.com/api/articles/editorial-inventory

# Groq curates discovery batches; Grok CLI authentication is stored under ~/.grok.
GROQ_API_KEY=replace-me
ARTICLE_CURATION_MODEL=llama-3.3-70b-versatile
ARTICLE_WRITER_GROK_BIN=/home/teja/.grok/bin/grok
ARTICLE_WRITER_GROK_MODEL=grok-4.5
ARTICLE_WRITER_BATCH_SIZE=6
ARTICLE_WRITER_MAX_ATTEMPTS=3
ARTICLE_WRITER_TIMEOUT_MINUTES=300
