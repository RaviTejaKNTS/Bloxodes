{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "typeRoots": [
      "../../types",
      "../../node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-prod-preview",
    ".next-prod-preview-platform",
    "tmp",
    "src/lib/__tests__/stats-report.test.ts",
    "src/lib/__tests__/stats-report-assemble.test.ts",
    "src/lib/__tests__/stats-report-review-fixes.test.ts"
  ]
}
