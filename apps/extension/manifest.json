{
  "manifest_version": 3,
  "name": "Bloxodes - Roblox Game Codes",
  "version": "4.0.0",
  "description": "See the latest active Roblox game codes directly on Roblox game pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bloxodes - Roblox Codes"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://bloxodes.com/api/extension/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/games/*",
        "https://web.roblox.com/games/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
