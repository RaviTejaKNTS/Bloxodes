# Production Supabase + media (for overlap checks, prod publish, dev:prod preview).
# Copy to `.env` in the repo root. Never commit `.env`.
#
# Cursor Cloud: prefer injecting the BLOXODES_PROD_* secrets below and running
# `npm run setup:content-agent` so `.env` is generated without shadowing local `.env.local`.
#
# Local dev + verify importers use `.env.local` (see docs/local-supabase-workflow.md).

SUPABASE_URL=https://database.bloxodes.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

SUPABASE_MEDIA_PUBLIC_URL=https://media.bloxodes.com
SUPABASE_MEDIA_BUCKET=bloxodes-media

NEXT_PUBLIC_SITE_URL=https://bloxodes.com
SITE_URL=https://bloxodes.com

# Optional — only for explicit release / revalidation (not day-to-day content writing)
# REVALIDATE_SECRET=
# REVALIDATE_ENDPOINT=https://bloxodes.com/api/revalidate
