{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:local"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:prod"],
      "port": 5000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web:local", "-w", "@bloxodes/mobile"],
      "port": 8081
    }
  ]
}
