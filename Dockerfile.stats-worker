# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim

WORKDIR /app
ARG BLOXODES_BUILD_SHA=unknown
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV BLOXODES_BUILD_SHA=$BLOXODES_BUILD_SHA

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -c "import ssl; assert ssl.create_default_context().get_ca_certs(), 'Python HTTPS trust store is empty'"

COPY package.json package-lock.json tsconfig.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/extension/package.json ./apps/extension/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json

RUN npm ci --include=dev

COPY scripts ./scripts
COPY apps/web/src ./apps/web/src
COPY apps/web/next-env.d.ts ./apps/web/next-env.d.ts
COPY apps/web/tsconfig.json ./apps/web/tsconfig.json
COPY types ./types
COPY data ./data
COPY env/config.json ./env/config.json

# Fail the image build before deployment when a script runtime dependency is
# missing from the deliberately narrow worker image manifest.
RUN npm run stats:worker:smoke

ENV BLOXODES_ENV_PROFILE=process-only

CMD ["sh", "-lc", "eval \"${STATS_WORKER_COMMAND:-npm run stats:audit}\""]
