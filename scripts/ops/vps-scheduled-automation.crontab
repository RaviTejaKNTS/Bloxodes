# Bloxodes scheduled automation moved off GitHub Actions.
#
# Install these lines in the codex-admin crontab on the VPS, beside the
# existing BLOXODES_STATS_WORKER and BLOXODES_ITEM_STATS_WORKER blocks.
# The worker wrapper is expected at:
# /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh
#
# Required env lives in /home/codex-admin/bloxodes-stats-worker/env.stats-worker.
# It must include Supabase service-role env plus job-specific secrets such as
# Google Indexing, OpenAI/Tavily for event details, and LINKEDIN_LI_AT for
# LinkedIn puzzles when available.

# BLOXODES_SCHEDULED_AUTOMATION_START
35 0 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-daily-rollup "npm run stats:rollup-daily -- --date yesterday --finalize && npm run stats:prune-hourly -- --days 90 --apply && npm run stats:audit"
5 1 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-platform-refresh "npm run stats:platform:refresh -- --hourly-days 90 --daily-days 180"

0 */6 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh codes-refresh "export REFRESH_CONCURRENCY=6 REFRESH_BATCH_DELAY_MS=750; npm run refresh:codes"
17 */6 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh google-indexing "export GOOGLE_INDEXING_STATE_BACKEND=supabase; npm run indexing:google -- --apply"
40 9 * * 3 JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh promo-rewards-refresh "export ROBLOX_PROMO_RETIRE_AFTER_MISSES=2; npm run refresh:promo-rewards -- --apply --allow-prod"

15 0 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh events-refresh "export ROBLOX_VIRTUAL_EVENTS_LIMIT=200; npm run collect:virtual-events && npm run seed:event-details -- --all"

10 4 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-early-nyt "npm run sync:puzzles -- --group early-nyt --skip-linkedin-if-missing"
45 4 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-beebom-with-early "npm run sync:puzzles -- --group beebom-with-early --skip-linkedin-if-missing"
0 5 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-beebom-with-early "npm run sync:puzzles -- --group beebom-with-early --skip-linkedin-if-missing"
30 5 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-beebom-with-early "npm run sync:puzzles -- --group beebom-with-early --skip-linkedin-if-missing"
10 7 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-late-nyt-linkedin "npm run sync:puzzles -- --group late-nyt-and-linkedin --skip-linkedin-if-missing"
10 8 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-late-nyt-linkedin "npm run sync:puzzles -- --group late-nyt-and-linkedin --skip-linkedin-if-missing"
30 8 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh puzzles-full-sweep "npm run sync:puzzles -- --group all --skip-linkedin-if-missing"

20 6 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh music-ids-refresh "export ROBLOX_TOP_SONGS_TARGET=500 ROBLOX_TOP_SONGS_PAGE_LIMIT=50 ROBLOX_TOP_SONGS_MAX_PAGES=10 ROBLOX_CURATED_INCLUDE_TOP_SONGS=false ROBLOX_CURATED_TOOLBOX_CHART_TYPES=Week,Month,Year ROBLOX_CURATED_TOOLBOX_INCLUDE_TRENDING=false ROBLOX_CURATED_TOOLBOX_MAX_PAGES=10 ROBLOX_CURATED_MAX_ASSETS=3000; npm run collect:top-songs && npm run collect:music-ids-curated && npm run rerank:music-ids"

55 6 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh decal-ids-refresh "export ROBLOX_DECAL_COLLECT_MAX_ASSETS=3000 ROBLOX_DECAL_TOOLBOX_MAX_PAGES=4 ROBLOX_DECAL_TOOLBOX_PAGE_SIZE=100 ROBLOX_DECAL_TOOLBOX_DELAY_MS=125 ROBLOX_DECAL_TOOLBOX_MAX_RETRIES=3 ROBLOX_DECAL_VERIFY_MAX_TOTAL=5000 ROBLOX_DECAL_VERIFY_BATCH=100 ROBLOX_DECAL_VERIFY_CONCURRENCY=8 ROBLOX_DECAL_VERIFY_ORDER=asset_id ROBLOX_DECAL_VERIFY_REFRESH_HOURS=168 ROBLOX_DECAL_VERIFY_REQUEST_DELAY_MS=80 ROBLOX_DECAL_VERIFY_BATCH_DELAY_MS=300; npm run refresh:decal-ids"

0 7 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh free-items-candidate-refresh "export ALLOW_PROD_FREE_ITEMS_IMPORT=true ROBLOXDEN_SKIP_FAVORITE_BACKFILL=true; npm run import:free-item-candidates"
30 7 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh free-items-refresh "export ROBLOX_FREE_ITEMS_DELAY_MS=650 ROBLOX_FREE_ITEMS_MAX_RETRIES=6; npm run collect:free-items -- --apply --allow-prod"

# Roblox Marketplace item pipeline. Each stage has its own lock so a slow
# discovery or index run cannot suppress enrichment, tier refreshes, or audits.
10 2 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh catalog-items-discovery "export ROBLOX_CATALOG_MIN_REQUEST_MS=1500 ROBLOX_CATALOG_QUERY_DELAY_MS=1800 ROBLOX_CATALOG_ENQUEUE_REFRESH=true ROBLOX_CATALOG_MAX_PAGES=2 ROBLOX_CATALOG_SORT_TYPES=RecentlyCreated,MostFavorited,BestSelling,RecentlyUpdated; npm run collect:catalog-items"
2,17,32,47 * * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh catalog-items-enrichment "export ROBLOX_CATALOG_ENRICH_LIMIT=200 ROBLOX_CATALOG_ENRICH_MAX_TOTAL=200 ROBLOX_CATALOG_ENRICH_MIN_REQUEST_MS=1500 ROBLOX_CATALOG_ENRICH_DETAILS_BATCH=10; npm run enrich:catalog-items"
5 1 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-tier "npm run stats:items:tier -- --apply"
7,22,37,52 * * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-new "export ROBLOX_ITEM_STATS_MIN_REQUEST_MS=1500 ROBLOX_ITEM_STATS_DETAILS_BATCH=10; npm run stats:items:refresh -- --tier NEW --limit 100 --skip-index-refresh"
12 * * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-hot "export ROBLOX_ITEM_STATS_MIN_REQUEST_MS=1500 ROBLOX_ITEM_STATS_DETAILS_BATCH=10; npm run stats:items:refresh -- --tier HOT --limit 200 --skip-index-refresh"
27 */6 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-warm "export ROBLOX_ITEM_STATS_MIN_REQUEST_MS=1500 ROBLOX_ITEM_STATS_DETAILS_BATCH=10; npm run stats:items:refresh -- --tier WARM --limit 400 --skip-index-refresh"
42 3 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-cold "export ROBLOX_ITEM_STATS_MIN_REQUEST_MS=1500 ROBLOX_ITEM_STATS_DETAILS_BATCH=10; npm run stats:items:refresh -- --tier COLD --limit 800 --skip-index-refresh"
28 1-23/3 * * * JOB_LOCK_GROUP=roblox-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-resale "export ROBLOX_ITEM_RESALE_MIN_REQUEST_MS=3000; npm run stats:items:resale -- --limit 50 --max-age-hours 24"
45 * * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-index "npm run stats:items:index:refresh"
25 1 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-rollup "npm run stats:items:rollup-daily -- --date yesterday --finalize"
55 */6 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-items-audit "npm run stats:items:audit -- --strict"
# BLOXODES_SCHEDULED_AUTOMATION_END
