[Unit]
Description=Retry authorized verified Bloxodes article publications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=teja
Group=teja
WorkingDirectory=/home/teja/.local/share/bloxodes-article-runtime/current
EnvironmentFile=/etc/bloxodes/article-automation.env
Environment=NODE_ENV=development
ExecStart=/usr/bin/npm run articles:publication:drain -- --apply
ExecStopPost=/usr/bin/npm run articles:automation:audit
Nice=10
CPUWeight=20
TimeoutStartSec=45min
