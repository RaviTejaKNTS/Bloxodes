[Unit]
Description=Retry authorized verified Bloxodes article publications
After=network-online.target
Wants=network-online.target
OnSuccess=bloxodes-article-audit.service
OnFailure=bloxodes-article-audit.service

[Service]
Type=oneshot
User=teja
Group=teja
WorkingDirectory=/home/teja/.local/share/bloxodes-automation-runtime/current
EnvironmentFile=/etc/bloxodes/article-automation.env
Environment=NODE_ENV=development
Environment=BLOXODES_AUTOMATION_RUNTIME=1
ExecStart=/usr/bin/npm run articles:publication:drain -- --apply
Nice=10
CPUWeight=20
TimeoutStartSec=45min
