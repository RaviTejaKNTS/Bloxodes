[Unit]
Description=Bloxodes managed-dev Luna article batch writer
After=network-online.target bloxodes-article-discovery.service
Wants=network-online.target

[Service]
Type=oneshot
User=teja
Group=teja
WorkingDirectory=/srv/data/bloxodes-automation-runtime/current
EnvironmentFile=/etc/bloxodes/article-automation.env
Environment=NODE_ENV=development
Environment=BLOXODES_AUTOMATION_RUNTIME=1
Environment=BLOXODES_CI_QA=1
Environment=ARTICLE_WRITER_WORKTREE=/srv/data/bloxodes-automation-runtime/current
Environment=ARTICLE_AUTO_PUBLISH=true
ExecStart=/usr/bin/npm run articles:writer:batch -- --apply --limit 6
Nice=10
CPUWeight=20
MemoryHigh=5G
MemoryMax=6G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5h30min

[Install]
WantedBy=multi-user.target
