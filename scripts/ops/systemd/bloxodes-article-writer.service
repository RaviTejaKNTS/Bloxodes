[Unit]
Description=Bloxodes managed-dev Grok article batch writer
After=network-online.target bloxodes-article-discovery.service
Wants=network-online.target

[Service]
Type=oneshot
User=teja
Group=teja
WorkingDirectory=/home/teja/projects/Bloxodes
EnvironmentFile=/etc/bloxodes/article-automation.env
Environment=NODE_ENV=development
Environment=ARTICLE_WRITER_WORKTREE=/home/teja/projects/Bloxodes
Environment=ARTICLE_AUTO_PUBLISH=true
ExecStart=/usr/bin/npm run articles:homelab:check -- --component writer
ExecStart=/usr/bin/npm run articles:writer:batch -- --apply --limit 6
Nice=10
CPUWeight=20
MemoryHigh=5G
MemoryMax=6G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5h30min

[Install]
WantedBy=multi-user.target
