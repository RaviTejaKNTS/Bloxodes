[Unit]
Description=Bloxodes daily wiki hub and collection automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bloxodes-wiki-model
Group=bloxodes-wiki-model
WorkingDirectory=/home/teja/projects/Bloxodes
EnvironmentFile=/etc/bloxodes/wiki-automation.env
Environment=NODE_ENV=development
Environment=BLOXODES_ENV_PROFILE=managed-dev
Environment=BLOXODES_ENV_OVERLAYS=
Environment=WIKI_AUTOMATION_WORKTREE=/home/teja/projects/Bloxodes
Environment=WIKI_AUTOMATION_CONCURRENCY=1
Environment=WIKI_AUTOMATION_MAX_GAMES_PER_RUN=1
ReadWritePaths=/var/lib/bloxodes/wiki-model
ReadWritePaths=/home/teja/projects/Bloxodes/tmp/agent-work
ReadWritePaths=/home/teja/projects/Bloxodes/tmp/wiki-automation
ReadWritePaths=/home/teja/projects/Bloxodes/apps/web/.next/wiki-automation
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ExecStart=/usr/bin/npm run wiki:homelab:check
ExecStart=/usr/bin/npm run wiki:homelab:run -- --apply --skip-production-release
Nice=10
CPUWeight=20
MemoryHigh=5G
MemoryMax=6G
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
TimeoutStopSec=5min
KillMode=control-group

[Install]
WantedBy=multi-user.target
