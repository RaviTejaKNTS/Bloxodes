[Unit]
Description=Bloxodes article discovery and Groq curation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/data

[Service]
Type=oneshot
User=teja
Group=teja
WorkingDirectory=/srv/data/bloxodes-automation-runtime/current
EnvironmentFile=/etc/bloxodes/article-automation.env
Environment=NODE_ENV=production
Environment=BLOXODES_ENV_PROFILE=process-only
Environment=ARTICLE_DISCOVERY_STATE_DIR=/srv/data/bloxodes-automation-runtime/state/articles
Environment=HOME=/home/teja
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=BLOXODES_AUTOMATION_RUNTIME=1
Environment=BLOXODES_CI_QA=1
ExecStart=/usr/bin/npm run articles:discover -- --apply
ExecStart=/usr/bin/npm run articles:curate -- --apply
UMask=0077
MemoryMax=512M
Nice=10
CPUWeight=30
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
