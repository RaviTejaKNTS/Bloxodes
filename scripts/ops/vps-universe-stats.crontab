# Bloxodes universe stats worker schedule.
# Install this exact marked block in the codex-admin crontab. HOT refresh stays
# Northflank-owned for separate Roblox API capacity. Database-only hourly and
# daily ranks run here through the VPS-internal Supabase route.

# BLOXODES_STATS_WORKER_START
5 0 * * * /home/codex-admin/bloxodes-stats-worker/bin/build-image.sh >> /home/codex-admin/bloxodes-stats-worker/logs/build-image.log 2>&1
7 */2 * * * JOB_LOCK_GROUP=roblox-universe-api JOB_LOCK_WAIT_SECONDS=1800 /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-new-refresh "npm run enrich:universes:light -- --tier NEW --limit 1000 --batch 25 && npm run stats:refresh:new -- --limit 5000 --skip-index-refresh && npm run stats:tier -- --tier NEW && npm run enqueue:revalidation -- --source stats_new_vps --event stats:stats --event stats:games"
22 * * * * JOB_LOCK_GROUP=roblox-universe-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-discovery-priority "npm run discover:universes:priority && npm run enrich:universes:light -- --tier NEW --limit 500 --batch 25 && npm run stats:refresh:new -- --limit 1000 --skip-index-refresh && npm run stats:tier -- --tier NEW && npm run enrich:universes:light -- --tier HOT --limit 250 --batch 25 && npm run enqueue:revalidation -- --source stats_discovery_priority_vps --event stats:stats --event stats:games"
32 */6 * * * JOB_LOCK_GROUP=roblox-universe-api JOB_LOCK_WAIT_SECONDS=1800 /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-warm-refresh "npm run stats:refresh:warm -- --limit 20000 --skip-index-refresh && npm run stats:tier -- --tier WARM && npm run enqueue:revalidation -- --source stats_warm_vps --event stats:stats --event stats:games"
47 1-11,13-23 * * * JOB_LOCK_GROUP=roblox-universe-api JOB_LOCK_WAIT_SECONDS=1800 /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-cold-refresh "npm run stats:refresh:cold -- --limit 4000 --skip-index-refresh && npm run stats:tier -- --tier COLD && npm run enqueue:revalidation -- --source stats_cold_vps --event stats:stats --event stats:games"
30 * * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-hourly-ranks "npm run stats:rank:hourly && npm run enqueue:revalidation -- --source stats_hourly_ranks_vps --event stats:games"
40 * * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-current-index "npm run stats:index:refresh"
50 0 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-daily-ranks "npm run stats:rank:daily && npm run enqueue:revalidation -- --source stats_daily_ranks_vps --event stats:games"
35 1 * * * JOB_LOCK_GROUP=roblox-universe-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-discovery "npm run collect:universes && npm run enrich:universes:light -- --tier NEW --limit 1000 --batch 25"
20 3 * * * JOB_LOCK_GROUP=roblox-universe-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-discovery-search "npm run discover:universes:search -- --max-pages 2 && npm run enrich:universes:light -- --tier NEW --limit 1000 --batch 25"
10 4 * * * JOB_LOCK_GROUP=roblox-universe-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-discovery-creators "npm run discover:universes:creators -- --limit 500 --max-pages 2 && npm run enrich:universes:light -- --tier NEW --limit 1000 --batch 25"
5 5 * * * JOB_LOCK_GROUP=roblox-universe-api /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-deep-enrichment "npm run enrich:universes:deep -- --tier HOT --limit 500 --batch 25"
10 */6 * * * /home/codex-admin/bloxodes-stats-worker/bin/run-job.sh stats-audit "npm run stats:audit"
# BLOXODES_STATS_WORKER_END
