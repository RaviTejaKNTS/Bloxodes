# Public site and runtime behavior
NEXT_PUBLIC_SITE_URL=https://bloxodes.com
SITE_URL=https://bloxodes.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_LOCAL_CONSENT=false
NEXT_PUBLIC_DEFAULT_AUTHOR_ID=
CSP_MODE=off
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=2592000
PUZZLES_TIMEZONE=Asia/Kolkata
REVALIDATE_ENDPOINT=https://bloxodes.com/api/revalidate
REVALIDATE_SECRET=
ADMIN_API_TOKEN=
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_LOGIN_REDIRECT_URI=http://localhost:3000/auth/roblox/callback
# Optional wiki collection runtime overrides. Defaults are database-first and the
# canonical media.bloxodes.com/wiki path shared by managed development and production.
WIKI_COLLECTION_DATA_SOURCE=database-first
# Optional comma-separated collection codes that must load from managed database runtime and may never use local fallback.
WIKI_COLLECTION_DATABASE_REQUIRED_CODES=
WIKI_MEDIA_PUBLIC_BASE_URL=
