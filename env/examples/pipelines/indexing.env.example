GOOGLE_INDEXING_API_ENABLED=false
GOOGLE_INDEXING_SERVICE_ACCOUNT_EMAIL=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_INDEXING_SERVICE_ACCOUNT_FILE=.envs/secrets/google-indexing-service-account.json
GOOGLE_INDEXING_SCOPE=https://www.googleapis.com/auth/indexing
GOOGLE_INDEXING_SITE_URL=https://bloxodes.com
GOOGLE_INDEXING_SITEMAP_URL=https://bloxodes.com/sitemap.xml
GOOGLE_INDEXING_DAILY_LIMIT=50
GOOGLE_INDEXING_BATCH_LIMIT=10
GOOGLE_INDEXING_MAX_SITEMAPS=200
GOOGLE_INDEXING_REQUEST_DELAY_MS=1000
GOOGLE_INDEXING_RESUBMIT_AFTER_HOURS=168
GOOGLE_INDEXING_STATE_BACKEND=auto
GOOGLE_INDEXING_STATE_FILE=tmp/google-indexing-state.json
