# Managed-development control plane and content staging target.
WIKI_DEV_SUPABASE_URL=https://your-managed-project.supabase.co
WIKI_DEV_SUPABASE_SERVICE_ROLE=replace-me

# Shared Cloudflare R2 bucket used by both managed development and production.
WIKI_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
WIKI_R2_ACCESS_KEY_ID=replace-me
WIKI_R2_SECRET_ACCESS_KEY=replace-me
WIKI_R2_BUCKET=bloxodes-wiki
WIKI_MEDIA_PUBLIC_URL=https://media.bloxodes.com/wiki

# Read only by the outer post-agent publisher, never copied into the model environment.
WIKI_RELEASE_PRODUCTION_ENV_FILE=/srv/data/projects/Bloxodes/.envs/targets/production.env

WIKI_AUTOMATION_MODEL_HOME=/var/lib/bloxodes/wiki-model
WIKI_AUTOMATION_CODEX_BIN=/home/teja/.local/bin/codex
# Stage defaults use Luna max and Haiku 5.5 xhigh. Old Codex values are opt-in.
# WIKI_STAGE_USE_LEGACY_CODEX_DEFAULTS=true
# WIKI_AUTOMATION_CODEX_MODEL=gpt-6-luna
# WIKI_AUTOMATION_CODEX_REASONING=max

WIKI_CLAUDE_BIN=/home/teja/.local/bin/claude
# Add the real token only to /etc/bloxodes/wiki-automation.env with sudo.
# The model user has its own HOME, without the owner's Claude login.
# CLAUDE_CODE_OAUTH_TOKEN=replace-me

# Each stage supports PROVIDER, MODEL, EFFORT and TIMEOUT_MINUTES overrides.
# These override legacy defaults. A stage retains its first config across repairs.
# Stage names:
# COLLECTION_SUGGESTIONS, COLLECTION_RESEARCH, COLLECTION_RESEARCH_REVIEW,
# COLLECTION_DATA, COLLECTION_DATA_REVIEW, COLLECTION_IMAGES,
# COLLECTION_IMAGE_REVIEW, COLLECTION_WRITING, COLLECTION_EDITORIAL_REVIEW,
# HUB_RESEARCH, HUB_RESEARCH_REVIEW, HUB_WRITING, HUB_EDITORIAL_REVIEW.
# WIKI_STAGE_COLLECTION_RESEARCH_PROVIDER=codex
# WIKI_STAGE_COLLECTION_RESEARCH_MODEL=gpt-6-luna
# WIKI_STAGE_COLLECTION_RESEARCH_EFFORT=max
# WIKI_STAGE_COLLECTION_RESEARCH_TIMEOUT_MINUTES=45
# WIKI_STAGE_HUB_WRITING_PROVIDER=claude
# WIKI_STAGE_HUB_WRITING_MODEL=claude-haiku-5-5
# WIKI_STAGE_HUB_WRITING_EFFORT=xhigh
# WIKI_STAGE_HUB_WRITING_TIMEOUT_MINUTES=90
# Defaults are 90 minutes for writing, 60 for reviews, 45 for other stages.
# All stage limits are bounded by WIKI_AUTOMATION_TIMEOUT_MINUTES.
WIKI_AUTOMATION_TIMEOUT_MINUTES=660
WIKI_AUTOMATION_CONCURRENCY=1
WIKI_AUTOMATION_MAX_GAMES_PER_RUN=1

# Optional exact existing queue row for a recovery run; omit for normal selection.
# WIKI_AUTOMATION_QUEUE_ID=00000000-0000-0000-0000-000000000000
