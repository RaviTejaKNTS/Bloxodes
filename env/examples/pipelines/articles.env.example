ARTICLE_DEV_SUPABASE_URL=
ARTICLE_DEV_SUPABASE_SERVICE_ROLE=
ARTICLE_PRODUCTION_INVENTORY_URL=https://bloxodes.com/api/articles/editorial-inventory
SUPABASE_MEDIA_BUCKET=media
SUPABASE_MEDIA_PUBLIC_URL=
GROQ_API_KEY=
ARTICLE_CURATION_MODEL=openai/gpt-oss-120b
ARTICLE_WRITER_CODEX_BIN=codex
# Stage controls override built-in defaults. Keep provider/model/effort consistent.
ARTICLE_CLAUDE_BIN=/home/teja/.local/bin/claude
ARTICLE_STAGE_RESEARCH_PROVIDER=codex
ARTICLE_STAGE_RESEARCH_MODEL=gpt-6-luna
ARTICLE_STAGE_RESEARCH_EFFORT=max
ARTICLE_STAGE_RESEARCH_TIMEOUT_MINUTES=
ARTICLE_STAGE_RESEARCH_REVIEW_PROVIDER=claude
ARTICLE_STAGE_RESEARCH_REVIEW_MODEL=claude-haiku-5-5
ARTICLE_STAGE_RESEARCH_REVIEW_EFFORT=xhigh
ARTICLE_STAGE_RESEARCH_REVIEW_TIMEOUT_MINUTES=
ARTICLE_STAGE_IMAGES_PROVIDER=codex
ARTICLE_STAGE_IMAGES_MODEL=gpt-6-luna
ARTICLE_STAGE_IMAGES_EFFORT=max
ARTICLE_STAGE_IMAGES_TIMEOUT_MINUTES=
ARTICLE_STAGE_IMAGE_REVIEW_PROVIDER=claude
ARTICLE_STAGE_IMAGE_REVIEW_MODEL=claude-haiku-5-5
ARTICLE_STAGE_IMAGE_REVIEW_EFFORT=xhigh
ARTICLE_STAGE_IMAGE_REVIEW_TIMEOUT_MINUTES=
ARTICLE_STAGE_WRITING_PROVIDER=claude
ARTICLE_STAGE_WRITING_MODEL=claude-haiku-5-5
ARTICLE_STAGE_WRITING_EFFORT=xhigh
ARTICLE_STAGE_WRITING_TIMEOUT_MINUTES=90
ARTICLE_STAGE_EDITORIAL_REVIEW_PROVIDER=codex
ARTICLE_STAGE_EDITORIAL_REVIEW_MODEL=gpt-6-luna
ARTICLE_STAGE_EDITORIAL_REVIEW_EFFORT=max
ARTICLE_STAGE_EDITORIAL_REVIEW_TIMEOUT_MINUTES=60
# Legacy Codex defaults apply only when this switch is true; stage values still win.
ARTICLE_STAGE_USE_LEGACY_CODEX_DEFAULTS=false
ARTICLE_WRITER_CODEX_MODEL=gpt-5.6-luna
ARTICLE_WRITER_CODEX_REASONING_EFFORT=max
ARTICLE_WRITER_GROK_FALLBACK=true
ARTICLE_WRITER_GROK_BIN=grok
ARTICLE_WRITER_GROK_MODEL=grok-4.5
ARTICLE_WRITER_BATCH_SIZE=6
ARTICLE_WRITER_MAX_ATTEMPTS=3
ARTICLE_WRITER_TIMEOUT_MINUTES=300
# Base timeout for stages other than writing/editorial review. Stage overrides win.
ARTICLE_PIPELINE_STAGE_TIMEOUT_MINUTES=45
ARTICLE_PIPELINE_PREVIEW_PORT=3100
# Optional existing managed-development localhost/Tailscale preview; never production.
ARTICLE_PIPELINE_PREVIEW_BASE_URL=
ARTICLE_AUTO_PUBLISH=true
ARTICLE_RELEASE_PRODUCTION_ENV_FILE=.envs/targets/production.env
ARTICLE_RELEASE_VERIFY_ATTEMPTS=24
ARTICLE_RELEASE_VERIFY_DELAY_MS=5000
