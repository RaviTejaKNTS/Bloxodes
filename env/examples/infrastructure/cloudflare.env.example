CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BLOXODES_API=
CLOUDFLARE_PURGE_STRATEGY=tags
CLOUDFLARE_WARM_AFTER_PURGE=deferred
CLOUDFLARE_WARM_MAX_PATHS=200
CLOUDFLARE_WARM_CONCURRENCY=4

# Shared private wiki collection R2 bucket. Only the guarded publisher receives this bucket-scoped S3 token.
WIKI_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
WIKI_R2_ACCESS_KEY_ID=
WIKI_R2_SECRET_ACCESS_KEY=
WIKI_R2_BUCKET=bloxodes-wiki
